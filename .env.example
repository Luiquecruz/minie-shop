# =============================================================================
# Progressive Minie Shop — Monorepo Local Environment (.env.example)
# Copy to .env at repository root (never commit real secrets):
#   cp .env.example .env
# =============================================================================

# --- Runtime & Logging ---
NODE_ENV=development
API_PORT=3001
STOREFRONT_PORT=5199
LOG_LEVEL=info

# --- Storefront (Vite public env — browser accesses API on localhost) ---
VITE_API_URL=http://localhost:3001

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=minieshop
POSTGRES_PASSWORD=minieshop_dev_password
POSTGRES_DB=minieshop
POSTGRES_PORT=5432

# Internal Docker network URL (used by api, worker, migrate, seed containers)
DATABASE_URL=postgresql://minieshop:minieshop_dev_password@postgres:5432/minieshop

# --- Object Storage (SeaweedFS S3-compatible) ---
S3_PORT=8333
S3_MASTER_PORT=9333
S3_FILER_PORT=8888

# Internal endpoint (container-to-container S3 operations)
S3_ENDPOINT=http://storage:8333

# Public endpoint (browser-accessible URLs and presigned URLs)
S3_PUBLIC_ENDPOINT=http://localhost:8333

S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minieshop_dev_access_key
S3_SECRET_ACCESS_KEY=minieshop_dev_secret_key
S3_PUBLIC_BUCKET=minieshop-catalog-public
S3_PRIVATE_BUCKET=minieshop-private

# --- HTTP API (CORS, Signed Cookies, Security & Dev Chaos) ---
CORS_ORIGINS=http://localhost:5199
STOREFRONT_URL=http://localhost:5199
COOKIE_SECRET=minieshop-dev-cookie-secret-change-me
COOKIE_SECURE=false
CSRF_SECRET=minieshop-dev-csrf-secret-change-me-32chars
EMAIL_TOKEN_SECRET=minieshop-dev-email-token-secret-change-me
TRUST_PROXY=false
CUSTOMER_SESSION_IDLE_TTL_SECONDS=604800
CUSTOMER_SESSION_ABSOLUTE_TTL_SECONDS=2592000
STAFF_SESSION_IDLE_TTL_SECONDS=1800
STAFF_SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_TOUCH_THRESHOLD_SECONDS=300
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Active only in non-production (API refuses to boot if NODE_ENV=production & CHAOS_ENABLED=true)
CHAOS_ENABLED=true

# --- Search Engine (Meilisearch) ---
MEILI_PORT=7700
MEILI_MASTER_KEY=minieshop_dev_meili_master_key_32chars
MEILI_INDEX_PRODUCTS=products

# --- Local Embeddings (Ollama — optional profile: ai) ---
OLLAMA_PORT=11434
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_BASE_URL=http://embeddings:11434
EMBEDDINGS_MODEL=embeddinggemma
EMBEDDINGS_DIMENSIONS=768
SEARCH_SEMANTIC_RATIO=0.5

# --- Initial Admin Seed (dev only; production boot fails if default or empty) ---
ADMIN_EMAIL=admin@minieshop.local
ADMIN_PASSWORD=minieshop-dev-admin-pass-2026

# --- Transactional Email & Mailpit (Phase 5 — ADR-0015) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_TRANSPORT=smtp
MAIL_FROM="Progressive Minie Shop <no-reply@minieshop.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
RESEND_API_KEY=

# --- Recommendations Engine (Phase 4 — ADR-0013 / spec ADR-007) ---
RECOMMENDATIONS_RELATED_MIN_SIMILARITY=0.45
RECOMMENDATIONS_UPSELL_MIN_SIMILARITY=0.50
RECOMMENDATIONS_UPSELL_MIN_RATIO=1.10
RECOMMENDATIONS_UPSELL_MAX_RATIO=2.50
RECOMMENDATIONS_CROSS_SELL_MAX_PER_CATEGORY=2
RECOMMENDATIONS_REVERSE_FANOUT_LIMIT=20
