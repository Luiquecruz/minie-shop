{
  "name": "@minieshop/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog/public": {
      "types": "./dist/catalog/public.d.ts",
      "import": "./dist/catalog/public.js"
    },
    "./catalog/client": {
      "types": "./dist/catalog/client.d.ts",
      "import": "./dist/catalog/client.js"
    },
    "./search/public": {
      "types": "./dist/search/public.d.ts",
      "import": "./dist/search/public.js"
    },
    "./search/client": {
      "types": "./dist/search/client.d.ts",
      "import": "./dist/search/client.js"
    },
    "./recommendations/public": {
      "types": "./dist/recommendations/public.d.ts",
      "import": "./dist/recommendations/public.js"
    },
    "./recommendations/client": {
      "types": "./dist/recommendations/client.d.ts",
      "import": "./dist/recommendations/client.js"
    },
    "./identity/public": {
      "types": "./dist/identity/public.d.ts",
      "import": "./dist/identity/public.js"
    },
    "./identity/client": {
      "types": "./dist/identity/client.d.ts",
      "import": "./dist/identity/client.js"
    },
    "./identity/admin": {
      "types": "./dist/identity/admin.d.ts",
      "import": "./dist/identity/admin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "lint:pkg": "publint --strict",
    "test": "tsx --test src/**/*.test.ts",
    "format:check": "prettier --check \"src/**/*.ts\" --config ../config/prettier.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@minieshop/config": "workspace:*",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "publint": "0.3.25",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.26.1"
  }
}
