{
  "name": "@minieshop/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog/public": {
      "types": "./dist/catalog/public.d.ts",
      "import": "./dist/catalog/public.js"
    },
    "./identity/public": {
      "types": "./dist/identity/public.d.ts",
      "import": "./dist/identity/public.js"
    },
    "./identity/admin": {
      "types": "./dist/identity/admin.d.ts",
      "import": "./dist/identity/admin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check \"src/**/*.ts\" --config ../config/prettier.json"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@minieshop/config": "link:../config",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
