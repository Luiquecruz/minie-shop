# =============================================================================
# Progressive Minie Shop — Backend Local Environment (.env.example)
# Copy to infra/.env (never commit real secrets)
# =============================================================================

# --- Runtime & Logging ---
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=info

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=minieshop
POSTGRES_PASSWORD=minieshop_dev_password
POSTGRES_DB=minieshop
POSTGRES_PORT=5432

# Internal Docker network URL (used by api, migrate, seed containers)
DATABASE_URL=postgresql://minieshop:minieshop_dev_password@postgres:5432/minieshop

# --- Object Storage (SeaweedFS S3-compatible) ---
S3_PORT=8333
S3_MASTER_PORT=9333
S3_FILER_PORT=8888

# Internal endpoint (container-to-container S3 operations)
S3_ENDPOINT=http://storage:8333

# Public endpoint (browser-accessible URLs and presigned URLs)
S3_PUBLIC_ENDPOINT=http://localhost:8333

S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minieshop_dev_access_key
S3_SECRET_ACCESS_KEY=minieshop_dev_secret_key
S3_PUBLIC_BUCKET=minieshop-catalog-public
S3_PRIVATE_BUCKET=minieshop-private
