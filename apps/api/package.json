{
  "name": "@minieshop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker:dev": "tsx src/worker/main.ts",
    "worker:start": "node dist/worker/main.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/seed/seed.ts",
    "media:add": "tsx src/cli/media-add.ts",
    "search:init": "tsx src/cli/search-init.ts",
    "search:reindex": "tsx src/cli/search-reindex.ts",
    "search:status": "tsx src/cli/search-status.ts",
    "search:eval": "tsx src/cli/search-eval.ts",
    "embeddings:reindex": "tsx src/cli/embeddings-reindex.ts",
    "embeddings:status": "tsx src/cli/embeddings-status.ts",
    "outbox:stats": "tsx src/cli/outbox-cli.ts stats",
    "outbox:requeue": "tsx src/cli/outbox-cli.ts requeue",
    "outbox:wait-drain": "tsx src/cli/outbox-cli.ts wait-drain",
    "relations:rebuild": "tsx src/cli/relations-rebuild.ts",
    "relations:status": "tsx src/cli/relations-status.ts",
    "relations:add": "tsx src/cli/relations-curate.ts add",
    "relations:remove": "tsx src/cli/relations-curate.ts remove",
    "staff:create": "tsx src/cli/staff-create.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "vitest run",
    "test:security": "vitest run src/test/identity-base.integration.spec.ts src/test/customer-auth.integration.spec.ts src/test/email-flows.integration.spec.ts src/test/staff-rbac.integration.spec.ts src/test/customer-profile.integration.spec.ts src/test/favorites-merge.integration.spec.ts src/test/audit-log.integration.spec.ts src/test/security-matrix.integration.spec.ts",
    "test:e2e:mailpit": "RUN_MAILPIT_E2E=true vitest run src/test/mailpit.e2e.spec.ts",
    "build": "eslint src/ && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check \"src/**/*.ts\" --config ../../packages/config/prettier.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.777.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "13.2.0",
    "@minieshop/contracts": "link:../../packages/contracts",
    "@minieshop/email": "link:../../packages/email",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-fastify": "^11.0.12",
    "argon2": "0.45.2",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.2.2",
    "nodemailer": "10.6.1",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@minieshop/config": "link:../../packages/config",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.22.0",
    "eslint-import-resolver-typescript": "^3.8.7",
    "eslint-plugin-boundaries": "^5.0.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^5.1.1"
  }
}
