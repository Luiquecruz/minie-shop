{
  "name": "@minieshop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "media:add": "tsx src/cli/media-add.ts",
    "build": "eslint src/ && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check \"src/**/*.ts\" --config ../../packages/config/prettier.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.777.0",
    "@minieshop/contracts": "link:../../packages/contracts",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-fastify": "^11.0.12",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.2.2",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@minieshop/config": "link:../../packages/config",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.22.0",
    "eslint-import-resolver-typescript": "^3.8.7",
    "eslint-plugin-boundaries": "^5.0.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
