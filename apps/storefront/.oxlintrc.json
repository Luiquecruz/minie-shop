{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc", "typescript", "jsx-a11y", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error"
  },
  "overrides": [
    {
      "files": [
        "src/components/**/*.{ts,tsx}",
        "src/pages/**/*.{ts,tsx}",
        "src/layouts/**/*.{ts,tsx}",
        "src/context/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/infrastructure/*", "**/infrastructure/**"],
                "message": "Presentation and context layers must not import infrastructure directly. Use domain ports or hooks instead."
              },
              {
                "group": ["**/store/slices/*", "**/store/slices/**"],
                "message": "Presentation layers must not import Redux slices directly. Consume state/constants via hooks."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "Domain layer must remain framework-agnostic (no React imports)."
              },
              {
                "name": "react-dom",
                "message": "Domain layer must remain framework-agnostic (no React DOM imports)."
              },
              {
                "name": "react-redux",
                "message": "Domain layer must remain framework-agnostic (no Redux imports)."
              },
              {
                "name": "@reduxjs/toolkit",
                "message": "Domain layer must remain framework-agnostic (no Redux Toolkit imports)."
              }
            ],
            "patterns": [
              {
                "group": ["**/infrastructure/*", "**/infrastructure/**"],
                "message": "Domain layer must not depend on infrastructure adapters."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/__tests__/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
