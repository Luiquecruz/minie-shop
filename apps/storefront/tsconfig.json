{
  "extends": "@minieshop/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "isolatedModules": true,
    "allowJs": false,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src"]
}
