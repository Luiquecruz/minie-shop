{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["VITE_*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "PORT",
        "HOST",
        "LOG_LEVEL",
        "DATABASE_URL",
        "S3_*",
        "CORS_ORIGINS",
        "STOREFRONT_URL",
        "COOKIE_*",
        "CSRF_SECRET",
        "EMAIL_TOKEN_SECRET",
        "TRUST_PROXY",
        "CUSTOMER_SESSION_*",
        "STAFF_SESSION_*",
        "SESSION_*",
        "ARGON2_*",
        "MAIL_*",
        "SMTP_*",
        "RESEND_API_KEY",
        "ADMIN_*",
        "CHAOS_ENABLED",
        "MEILI_*",
        "WORKER_*",
        "OUTBOX_*",
        "EMBEDDINGS_*",
        "SEARCH_*",
        "RECOMMENDATIONS_*",
        "VITE_*"
      ]
    }
  }
}
